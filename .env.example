APP_PORT=8000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_WORKSPACE_ID=your_anthropic_workspace_id_here
CUBE_API_URL=http://localhost:4000/cubejs-api/v1/load
# Optional: pin "today" so relative dates ("last month", "this week") land inside the CSV export window.
# Leave blank to use the real clock. The export covers roughly 2026-06-01 to 2026-09-01.
ASSUME_TODAY=
# Optional: override the Claude model used for translation (defaults to claude-sonnet-5-5).
CLAUDE_MODEL=
# low (default) | medium | high: how hard Claude thinks before translating a question
CLAUDE_EFFORT=
# Model for the short "why nothing was found" explanations (default claude-haiku-5-5)
CLAUDE_SMALL_MODEL=
# How long to wait for Claude before giving up, in milliseconds (default 20000)
CLAUDE_TIMEOUT_MS=
# 🧊 Architecture's ⚠️ Risk monitor: what Claude may cost in 24 hours before the risk comes true (default 5)
CLAUDE_DAILY_BUDGET_USD=
# live = ask Claude as usual. offline = the presentation's emergency switch: the AI assistant
# never asks Claude and answers only questions asked before (npm run warmup), labelled
# "Offline mode". Change it, then: docker restart analytics_node_app (saved answers are kept).
DEMO_MODE=live
# Which AI translates questions: claude (default, the Claude API and CLAUDE_MODEL above) or
# local (a free model on this computer through Ollama). docker-compose.local-ai.yml sets it
# for you; see README "Two versions of the AI assistant".
AI_PROVIDER=
# The offline version's model (default qwen3:4b, Apache 2.0) and Ollama's address (default http://ollama:11434)
LOCAL_LLM_MODEL=
LOCAL_LLM_URL=
# How many words (tokens) the local model reads at once (default 28672; the system prompt is ~22k)
LOCAL_LLM_CONTEXT=
# How long to wait for the local model, in milliseconds (default 600000: a processor is slow)
LOCAL_LLM_TIMEOUT_MS=
# How many earlier questions the local model sees in a conversation (default 4)
LOCAL_LLM_TURNS=

# Database / Cube secrets (docker-compose.yml reads these; it refuses to start without them).
# Long random values, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=change_me_long_random_string
# Cube checks a token signed with this on every request; the app signs its own
CUBEJS_API_SECRET=change_me_long_random_string
# The read-only database role Cube connects as (cube_reader)
CUBE_DB_PASSWORD=change_me_long_random_string

# Sign-in account database (onetouch_auth): password for its onetouch_app role.
# Use a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AUTH_DB_PASSWORD=change_me_long_random_string

# Metabase: password for the read-only database role it connects as (metabase_reader),
# and the admin login that scripts/metabase-setup.mjs creates. Pick your own values.
METABASE_DB_PASSWORD=change_me_long_random_string
METABASE_ADMIN_EMAIL=you@example.com
METABASE_ADMIN_PASSWORD=change_me_8plus_chars
# Signs each person's dashboard links, so Metabase shows them only their tickets
# (64 hex characters): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METABASE_EMBEDDING_SECRET=change_me_64_hex_characters

# Optional: permanent Cloudflare link. The token from the tunnel you create in the
# Cloudflare dashboard (route it to http://app:8000), and the address you gave it, which
# `npm run share` prints. See "Sharing over the internet with Cloudflare" in README.md.
TUNNEL_TOKEN=
ONETOUCH_PUBLIC_URL=

# Optional: the "warmup" account's password, so `npm run warmup` signs in without asking.
# Create the account first: docker exec -it analytics_node_app node scripts/users.mjs add warmup "Warmup"
WARMUP_PASSWORD=

# Optional: the test accounts' passwords (tests sign in as tester1 and tester2, never as a
# real person or warmup). Create them with scripts/users.mjs add tester1 "Test Account 1".
TESTER1_PASSWORD=
TESTER2_PASSWORD=

# Optional: notification emails (mail.mjs), sent through Brevo (brevo.com). Without a key,
# email is off and notifications only show under the 🔔. Brevo → SMTP & API → API keys.
BREVO_API_KEY=
# The sender, on a domain authenticated in Brevo, and the name it shows
MAIL_FROM=notifications@onetouch.fyi
MAIL_FROM_NAME=OneTouch
# Where the emails' "Open OneTouch" button goes
APP_URL=https://onetouch.fyi
# While trying email out: only these addresses (comma-separated) are emailed. Delete the
# line (or leave it empty) to email everyone with an address on file.
MAIL_ONLY_TO=
# How many emails Brevo's plan sends in a day, for the ⚠️ Risk monitor (default 300, the free plan)
BREVO_DAILY_LIMIT=
